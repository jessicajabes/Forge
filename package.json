{
  "name": "@jessicajabes/forge",
  "version": "0.0.0",
  "description": "A TypeScript CLI that routes a coding task through a fixed LLM pipeline: interview, plan, parallel-arena dev, review, and lessons.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:manual": "vitest run --config vitest.manual.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "forge-jj": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    ".workflow.example.yml",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "README.md"
  ]
}
